# A FOK fills across levels when the quantity is there.
> new 1 sell gtc 2 @100
< ack 1 sell qty=2 px=100 leaves=2
< level sell px=100 qty=2
> new 2 sell gtc 3 @101
< ack 2 sell qty=3 px=101 leaves=3
< level sell px=101 qty=3
> new 3 buy fok 4 @101
< ack 3 buy qty=4 px=101 leaves=4
< fill 1 sell qty=2 px=100 contra=3 leaves=0
< fill 3 buy qty=2 px=100 contra=1 leaves=2 aggr
< trade 3 buy qty=2 px=100 contra=1 leaves=2
< level sell px=100 qty=0 removed
< fill 2 sell qty=2 px=101 contra=3 leaves=1
< fill 3 buy qty=2 px=101 contra=2 leaves=0 aggr
< trade 3 buy qty=2 px=101 contra=2 leaves=0
< level sell px=101 qty=1
= depth sell px=101 qty=1 orders=1
= hash 0x0426d04778c56c00
