# .env.example — copy to .env; no secrets in this project
# --- data locations (all paths may be relative to the repo root) ---
DATA_ROOT=~/data/low-latency-matching-engine   # required: data root inside the WSL ext4 filesystem, never /mnt/*; the repo's data/ is a symlink to it
LLME_DATA_DIR=data                         # required: root for raw/, interim/, processed/ (git-ignored symlink to DATA_ROOT)
LLME_RESULTS_DIR=results                   # required: where benchmark/diff/fuzz outputs are written
LLME_ITCH_FILE=data/raw/itch/01302019.NASDAQ_ITCH50.gz   # optional until M5: ITCH 5.0 sample day
LLME_BOOK_L3_DIR=                          # optional: itch-feed-handler book_l3 Parquet root (empty = use fallback decoder)
LLME_LOBSTER_DIR=data/raw/lobster          # optional until M5: unzipped LOBSTER sample files

# --- benchmark core pinning (native Linux; leave empty in WSL2 to disable pinning) ---
LLME_BENCH_CORE=2                          # optional: core for the matching thread (should be in isolcpus)
LLME_PRODUCER_CORE=3                       # optional: core for the gateway / producer thread
LLME_CONSUMER_CORE=4                       # optional: core for the publisher / consumer thread

# --- run behaviour ---
LLME_LOG_LEVEL=info                        # optional: trace|debug|info|warn|error (never used on the hot path)
LLME_FUZZ_SECONDS=60                       # optional: per-target duration for scripts/fuzz.sh (CI smoke = 60)
