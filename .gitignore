# Data: never commit raw or licensed data
# data is a symlink to $DATA_ROOT, which "data/" alone would not match
/data
data/
*.parquet
*.feather
*.h5
*.itch
*.pcap
*.gz
*.zst
*.mlog
*.olog
# Small synthetic fixtures and shrunk reproducers are the only logs in git (DQ-10)
!tests/fixtures/**/*.mlog
!tests/fixtures/*.mlog

# Per-run report from llme-run; the committed evidence lives in results/diff and results/fuzz
results/run.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/

# C++ / Rust / CUDA builds
build/
cmake-build-*/
target/
*.o
*.obj
*.so
*.dll
*.pyd
*.exe

# Editors, OS, secrets
.vscode/
.idea/
.DS_Store
Thumbs.db
.env

# Local build spec (kept out of the public repo)
SPEC.html
