# Disabled on purpose, each with its reason (docs/decisions.md lists them too):
# - cppcoreguidelines-avoid-magic-numbers: wire layouts and bit tricks are full of literal
#   sizes; the static_asserts in messages.hpp are what guards them.
# - cppcoreguidelines-pro-bounds-pointer-arithmetic: the hot path indexes preallocated arrays
#   through raw pointers on purpose, and readers walk mmap-ed records.
# - cppcoreguidelines-pro-bounds-constant-array-index: same reason, indices are checked at
#   validation and bounds-checked access would cost a branch per record.
# - modernize-use-trailing-return-type: style only; the code base uses leading return types.
# - bugprone-easily-swappable-parameters: every matching signature is several integers, and
#   tests/golden and the differential harness catch swaps far better than a lint.
Checks: >
  -*,
  bugprone-*,
  performance-*,
  modernize-*,
  concurrency-*,
  cppcoreguidelines-*,
  readability-identifier-naming,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -modernize-use-trailing-return-type
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(include/llme|src)/.*'
CheckOptions:
  - { key: readability-identifier-naming.NamespaceCase, value: lower_case }
  - { key: readability-identifier-naming.ClassCase, value: CamelCase }
  - { key: readability-identifier-naming.StructCase, value: CamelCase }
  - { key: readability-identifier-naming.EnumCase, value: CamelCase }
  - { key: readability-identifier-naming.EnumConstantCase, value: CamelCase }
  - { key: readability-identifier-naming.FunctionCase, value: lower_case }
  - { key: readability-identifier-naming.VariableCase, value: lower_case }
  - { key: readability-identifier-naming.ParameterCase, value: lower_case }
  - { key: readability-identifier-naming.PrivateMemberCase, value: lower_case }
  - { key: readability-identifier-naming.PrivateMemberSuffix, value: _ }
  - { key: readability-identifier-naming.ConstexprVariableCase, value: CamelCase }
  - { key: readability-identifier-naming.ConstexprVariablePrefix, value: k }
  - { key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor, value: true }
  - { key: performance-unnecessary-value-param.AllowedTypes, value: 'Sink' }
